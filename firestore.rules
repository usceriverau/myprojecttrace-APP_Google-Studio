rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Core authentication & helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isMemberOfCompany(companyId) {
      return isSignedIn() && exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid));
    }

    function getCompanyDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function getUserDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data;
    }

    // 5-Role Hierarchy and Permission Helpers
    function isCompanyOwner(companyId) {
      return isSignedIn() && (
        getCompanyDoc(companyId).ownerUid == request.auth.uid ||
        getUserDoc(companyId).role == 'OWNER'
      );
    }

    function isCompanyAdmin(companyId) {
      return isMemberOfCompany(companyId) && (
        isCompanyOwner(companyId) || 
        getUserDoc(companyId).role in ['OWNER', 'ADMIN']
      );
    }

    function isProjectManager(companyId) {
      return isMemberOfCompany(companyId) && (
        isCompanyAdmin(companyId) || 
        getUserDoc(companyId).role in ['OWNER', 'ADMIN', 'PROJECT_MANAGER']
      );
    }

    function isAccounting(companyId) {
      return isMemberOfCompany(companyId) && (
        isCompanyAdmin(companyId) || 
        getUserDoc(companyId).role in ['OWNER', 'ADMIN', 'ACCOUNTING']
      );
    }

    function isFieldUser(companyId) {
      return isMemberOfCompany(companyId) && (
        getUserDoc(companyId).role == 'FIELD_USER'
      );
    }

    // Validation helpers
    function isValidCompany(data) {
      return data.companyId is string && data.companyId.size() <= 128 &&
             data.companyName is string && data.companyName.size() <= 200 &&
             data.ownerUid is string && data.ownerUid.size() <= 128 &&
             data.settings is map &&
             data.createdAt is string;
    }

    function isValidUser(data, companyId) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.companyId == companyId &&
             data.name is string && data.name.size() <= 150 &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['OWNER', 'ADMIN', 'PROJECT_MANAGER', 'FIELD_USER', 'ACCOUNTING'] &&
             data.createdAt is string;
    }

    function isValidUserDirectoryEntry(data, userId) {
      return data.userId == userId &&
             data.companyId is string && data.companyId.size() <= 128 &&
             data.createdAt is string;
    }

    function isValidClient(data, companyId) {
      return data.clientId is string && data.clientId.size() <= 128 &&
             data.companyId == companyId &&
             data.clientName is string && data.clientName.size() <= 200 &&
             data.createdAt is string;
    }

    function isValidProject(data, companyId) {
      return data.projectId is string && data.projectId.size() <= 128 &&
             data.companyId == companyId &&
             data.projectName is string && data.projectName.size() <= 200 &&
             data.contractValue is number && data.contractValue >= 0 &&
             data.status in ['ACTIVE', 'COMPLETED', 'ON_HOLD'] &&
             data.createdAt is string;
    }

    function isValidProjectDocument(data, companyId, projectId) {
      return data.documentId is string && data.documentId.size() <= 128 &&
             data.companyId == companyId &&
             data.projectId == projectId &&
             data.documentType in ['CONTRACT', 'CHANGE_ORDER', 'PERMIT', 'BLUEPRINT', 'INVOICE', 'OTHER'] &&
             data.fileName is string && data.fileName.size() <= 300 &&
             data.mimeType is string && data.mimeType.size() <= 100 &&
             data.secureStorageReference is string && data.secureStorageReference.size() <= 500 &&
             data.fileUrl is string && data.fileUrl.size() <= 1000 &&
             data.uploadedBy is string && data.uploadedBy.size() <= 150 &&
             data.createdAt is string;
    }

    function isValidProjectPhoto(data, companyId, projectId) {
      return data.photoId is string && data.photoId.size() <= 128 &&
             data.companyId == companyId &&
             data.projectId == projectId &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             data.createdAt is string;
    }

    function isValidProjectNote(data, companyId, projectId) {
      return data.noteId is string && data.noteId.size() <= 128 &&
             data.companyId == companyId &&
             data.projectId == projectId &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 4000 &&
             data.createdAt is string;
    }

    function isValidPurchase(data, companyId) {
      return data.purchaseId is string && data.purchaseId.size() <= 128 &&
             data.companyId == companyId &&
             data.totalAmount is number &&
             data.captureStatus in ['DRAFT', 'UPLOADING', 'PROCESSING', 'NEEDS_REVIEW', 'CONFIRMED', 'REJECTED'] &&
             data.createdBy is string &&
             data.createdAt is string;
    }

    function isValidReceiptPage(data, companyId, purchaseId) {
      return data.receiptPageId is string && data.receiptPageId.size() <= 128 &&
             data.companyId == companyId &&
             data.purchaseId == purchaseId &&
             data.pageNumber is number && data.pageNumber >= 1 &&
             data.imageStoragePath is string && data.imageStoragePath.size() <= 500 &&
             data.createdAt is string;
    }

    function isValidPurchaseItem(data, companyId, purchaseId) {
      return data.itemId is string && data.itemId.size() <= 128 &&
             data.companyId == companyId &&
             data.purchaseId == purchaseId &&
             data.rawItemText is string && data.rawItemText.size() <= 1000 &&
             data.createdAt is string;
    }

    function isValidPayment(data, companyId) {
      return data.paymentId is string && data.paymentId.size() <= 128 &&
             data.companyId == companyId &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.paymentDate is string && data.paymentDate.size() <= 20 &&
             data.amount is number && data.amount > 0 &&
             data.paymentType in ['DEPOSIT', 'PROGRESS_PAYMENT', 'CHANGE_ORDER_PAYMENT', 'FINAL_PAYMENT', 'OTHER'] &&
             data.status in ['PENDING', 'RECEIVED', 'CLEARED', 'CANCELLED'] &&
             data.createdBy is string &&
             data.createdAt is string;
    }

    function isValidFinancialAlert(data, companyId) {
      return data.alertId is string && data.alertId.size() <= 128 &&
             data.companyId == companyId &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.alertType is string && data.alertType.size() <= 100 &&
             data.severity in ['INFO', 'WARNING', 'CRITICAL'] &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             data.status in ['OPEN', 'ACKNOWLEDGED', 'RESOLVED'] &&
             data.createdAt is string;
    }

    // 1. User lookup directory: maps authenticated userId to company workspace
    match /user_directory/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow list: if false; // Tenant isolation
      
      allow create, update: if isSignedIn() && 
                            request.auth.uid == userId && 
                            incoming().userId == userId &&
                            isValidUserDirectoryEntry(incoming(), userId) &&
                            exists(/databases/$(database)/documents/companies/$(incoming().companyId)/users/$(request.auth.uid));

      allow delete: if isSignedIn() && (request.auth.uid == userId);
    }

    // 2. Company workspace document
    match /companies/{companyId} {
      allow get: if isValidId(companyId) && (isMemberOfCompany(companyId) || (isSignedIn() && resource.data.ownerUid == request.auth.uid));
      allow list: if false; // Tenant isolation
      
      // Creation: must be signed in, ownerUid must match authenticated user
      allow create: if isValidId(companyId) && isSignedIn() && 
                    incoming().ownerUid == request.auth.uid && 
                    incoming().companyId == companyId && 
                    isValidCompany(incoming());
                    
      // Update: only OWNER or ADMIN can update company settings; ownerUid & companyId are IMMUTABLE
      allow update: if isValidId(companyId) && isCompanyAdmin(companyId) && 
                    incoming().ownerUid == existing().ownerUid && 
                    incoming().companyId == existing().companyId && 
                    isValidCompany(incoming());
                    
      allow delete: if false;

      // 3. Users subcollection with strict Anti-Escalation & Role Protection
      match /users/{userId} {
        allow get: if isValidId(userId) && isMemberOfCompany(companyId);
        allow list: if isMemberOfCompany(companyId);

        // CREATE:
        // - Initial Owner registration when creating company workspace
        // - Real Owner creating an ADMIN, PROJECT_MANAGER, FIELD_USER, or ACCOUNTING (never another OWNER)
        // - Admin creating PROJECT_MANAGER, FIELD_USER, or ACCOUNTING (never OWNER or ADMIN)
        allow create: if isValidId(userId) && isValidUser(incoming(), companyId) && (
          (request.auth.uid == userId && 
           incoming().role == 'OWNER' && 
           incoming().userId == userId && 
           getCompanyDoc(companyId).ownerUid == request.auth.uid) ||
          (isCompanyOwner(companyId) && 
           incoming().role in ['ADMIN', 'PROJECT_MANAGER', 'FIELD_USER', 'ACCOUNTING'] && 
           incoming().role != 'OWNER') ||
          (isCompanyAdmin(companyId) && 
           !isCompanyOwner(companyId) && 
           incoming().role in ['PROJECT_MANAGER', 'FIELD_USER', 'ACCOUNTING'])
        );

        // UPDATE:
        // - Self-update (ANY member modifying own record): can update profile (e.g. name, phone),
        //   but userId, companyId, role, and createdAt are STRICTLY IMMUTABLE.
        // - Owner updating OTHER member: can change role between non-OWNER roles (never another OWNER).
        // - Admin updating OTHER member: can modify PROJECT_MANAGER, FIELD_USER, ACCOUNTING. Cannot touch Owner.
        allow update: if isValidId(userId) && isValidUser(incoming(), companyId) && (
          // Branch A: Self-update (Strict role and identity immutability)
          (request.auth.uid == userId && 
           incoming().role == existing().role && 
           incoming().companyId == existing().companyId && 
           incoming().userId == existing().userId && 
           incoming().createdAt == existing().createdAt) ||
          // Branch B: Real Owner updating another user
          (isCompanyOwner(companyId) && 
           request.auth.uid != userId && 
           incoming().role in ['ADMIN', 'PROJECT_MANAGER', 'FIELD_USER', 'ACCOUNTING'] && 
           incoming().companyId == existing().companyId && 
           incoming().userId == existing().userId && 
           incoming().createdAt == existing().createdAt) ||
          // Branch C: Admin updating another non-owner user
          (isCompanyAdmin(companyId) && 
           !isCompanyOwner(companyId) && 
           request.auth.uid != userId && 
           existing().role in ['PROJECT_MANAGER', 'FIELD_USER', 'ACCOUNTING'] && 
           existing().userId != getCompanyDoc(companyId).ownerUid && 
           incoming().role in ['PROJECT_MANAGER', 'FIELD_USER', 'ACCOUNTING'] && 
           incoming().companyId == existing().companyId && 
           incoming().userId == existing().userId && 
           incoming().createdAt == existing().createdAt)
        );

        // DELETE:
        // - Real Owner can remove any member except themselves
        // - Admin can remove non-admin/non-owner members only
        allow delete: if isValidId(userId) && (
          (isCompanyOwner(companyId) && existing().role != 'OWNER' && userId != request.auth.uid) ||
          (isCompanyAdmin(companyId) && !isCompanyOwner(companyId) && existing().role in ['PROJECT_MANAGER', 'FIELD_USER', 'ACCOUNTING'] && userId != request.auth.uid)
        );
      }

      // 4. Clients subcollection
      match /clients/{clientId} {
        allow get, list: if isMemberOfCompany(companyId);
        allow create: if isValidId(clientId) && isProjectManager(companyId) && isValidClient(incoming(), companyId);
        allow update: if isValidId(clientId) && isProjectManager(companyId) && 
                      incoming().clientId == existing().clientId && 
                      incoming().companyId == existing().companyId && 
                      isValidClient(incoming(), companyId);
        allow delete: if isValidId(clientId) && isCompanyAdmin(companyId);
      }

      // 5. Projects subcollection (OWNER, ADMIN, PROJECT_MANAGER can mutate)
      match /projects/{projectId} {
        allow get, list: if isValidId(projectId) && isMemberOfCompany(companyId);
        allow create: if isValidId(projectId) && isProjectManager(companyId) && isValidProject(incoming(), companyId);
        allow update: if isValidId(projectId) && isProjectManager(companyId) && 
                      incoming().projectId == existing().projectId && 
                      incoming().companyId == existing().companyId && 
                      isValidProject(incoming(), companyId);
        allow delete: if isValidId(projectId) && isCompanyAdmin(companyId);

        // Project Documents subcollection
        match /documents/{documentId} {
          allow get, list: if isMemberOfCompany(companyId);
          allow create: if isValidId(documentId) && (isProjectManager(companyId) || isAccounting(companyId)) && isValidProjectDocument(incoming(), companyId, projectId);
          allow update: if isValidId(documentId) && (isProjectManager(companyId) || isAccounting(companyId)) && 
                        incoming().documentId == existing().documentId && 
                        incoming().companyId == existing().companyId && 
                        incoming().projectId == existing().projectId && 
                        isValidProjectDocument(incoming(), companyId, projectId);
          allow delete: if isValidId(documentId) && isProjectManager(companyId);
        }

        // Project Photos subcollection
        match /photos/{photoId} {
          allow get, list: if isMemberOfCompany(companyId);
          allow create: if isValidId(photoId) && isMemberOfCompany(companyId) && isValidProjectPhoto(incoming(), companyId, projectId);
          allow update: if isValidId(photoId) && (isProjectManager(companyId) || request.auth.uid == existing().uploadedBy) && isValidProjectPhoto(incoming(), companyId, projectId);
          allow delete: if isValidId(photoId) && (isProjectManager(companyId) || request.auth.uid == existing().uploadedBy);
        }

        // Project Notes subcollection
        match /notes/{noteId} {
          allow get, list: if isMemberOfCompany(companyId);
          allow create: if isValidId(noteId) && isMemberOfCompany(companyId) && isValidProjectNote(incoming(), companyId, projectId);
          allow update: if isValidId(noteId) && (isProjectManager(companyId) || request.auth.uid == existing().authorId) && isValidProjectNote(incoming(), companyId, projectId);
          allow delete: if isValidId(noteId) && (isProjectManager(companyId) || request.auth.uid == existing().authorId);
        }
      }

      // 6. Providers subcollection
      match /providers/{providerId} {
        allow get, list: if isMemberOfCompany(companyId);
        allow create, update: if isMemberOfCompany(companyId);
        allow delete: if isCompanyAdmin(companyId);
      }

      // 7. Purchases subcollection (Receipt tracking)
      match /purchases/{purchaseId} {
        allow get, list: if isValidId(purchaseId) && isMemberOfCompany(companyId);
        allow create: if isValidId(purchaseId) && isMemberOfCompany(companyId) && isValidPurchase(incoming(), companyId);
        allow update: if isValidId(purchaseId) && (
          isProjectManager(companyId) || 
          isAccounting(companyId) || 
          (request.auth.uid == existing().createdBy && existing().captureStatus in ['DRAFT', 'UPLOADING', 'PROCESSING', 'NEEDS_REVIEW'])
        ) && 
        incoming().purchaseId == existing().purchaseId && 
        incoming().companyId == existing().companyId && 
        isValidPurchase(incoming(), companyId);
        allow delete: if isValidId(purchaseId) && (isCompanyAdmin(companyId) || (request.auth.uid == existing().createdBy && existing().captureStatus in ['DRAFT', 'NEEDS_REVIEW']));

        // ReceiptPages subcollection
        match /receiptPages/{receiptPageId} {
          allow get, list: if isMemberOfCompany(companyId);
          allow create, update: if isMemberOfCompany(companyId) && isValidReceiptPage(incoming(), companyId, purchaseId);
          allow delete: if isMemberOfCompany(companyId);
        }

        // Items subcollection
        match /items/{itemId} {
          allow get, list: if isMemberOfCompany(companyId);
          allow create, update: if isMemberOfCompany(companyId) && isValidPurchaseItem(incoming(), companyId, purchaseId);
          allow delete: if isMemberOfCompany(companyId);
        }
      }

      // 8. Payments subcollection
      match /payments/{paymentId} {
        allow get, list: if isValidId(paymentId) && (isProjectManager(companyId) || isAccounting(companyId));
        allow create: if isValidId(paymentId) && (isProjectManager(companyId) || isAccounting(companyId)) && isValidPayment(incoming(), companyId);
        allow update: if isValidId(paymentId) && (isProjectManager(companyId) || isAccounting(companyId)) && 
                      incoming().paymentId == existing().paymentId && 
                      incoming().companyId == existing().companyId && 
                      isValidPayment(incoming(), companyId);
        allow delete: if isValidId(paymentId) && (isCompanyAdmin(companyId) || isAccounting(companyId));
      }

      // 9. Financial Alerts subcollection
      match /alerts/{alertId} {
        allow get, list: if isValidId(alertId) && isMemberOfCompany(companyId);
        allow create, update: if isMemberOfCompany(companyId) && isValidFinancialAlert(incoming(), companyId);
        allow delete: if isCompanyAdmin(companyId);
      }
    }
  }
}
